# =============================================================================
# Google Cloud Professional Agentic Architect — environment configuration
#
# Copy this file to .env and fill it in:
#     cp .env.example .env
#
# NOTE: Every lab runs OFFLINE and FREE by default. You only need these values
# if you want to run a lab's "Hands-on B" live path with --live.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud project
# -----------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT is the variable the Google Cloud client libraries and the
# ADK read natively. GCP_PROJECT_ID is accepted as a fallback.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Staging bucket for `adk deploy agent_engine` (must already exist).
# Create with: gcloud storage buckets create gs://YOUR-BUCKET --location=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=

# -----------------------------------------------------------------------------
# Model access — choose ONE of the two paths below
# -----------------------------------------------------------------------------
# Path A: Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
#   Simplest for labs. Set GOOGLE_GENAI_USE_VERTEXAI=FALSE.
GOOGLE_API_KEY=

# Path B: Vertex AI with Application Default Credentials
#   Run: gcloud auth application-default login
#   Then set GOOGLE_GENAI_USE_VERTEXAI=TRUE and leave GOOGLE_API_KEY empty.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# -----------------------------------------------------------------------------
# Model overrides (optional)
#
# Leave these blank to use the verified defaults in common/models.py.
# Only set them to a model ID present in that catalog — the labs validate this.
# -----------------------------------------------------------------------------
# AGENT_MODEL=gemini-3.7-flash
# FAST_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-2

# -----------------------------------------------------------------------------
# Optional backends used by specific labs
# -----------------------------------------------------------------------------
# Lab 09 — Memorystore for Redis session backend
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Lab 17 — Model Armor template IDs (create these in your project first)
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=

# -----------------------------------------------------------------------------
# Observability (Lab 15)
# -----------------------------------------------------------------------------
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_LOGGING=false
LOG_LEVEL=INFO

# ==============================================================================
# Google Cloud Certified Professional Agentic Architect - Environment Config
# ==============================================================================

# Google Cloud Platform Project Details
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_LOCATION=us-central1

# Google Gemini API Key (for Google AI Studio / Gemini 3.7 Flash)
GEMINI_API_KEY=your-gemini-api-key-here

# Target Gemini Model Configuration (Defaults to latest Gemini 3.7 Flash)
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_BUDGET=2048

# Agent Runtime & Gateway Endpoints
AGENT_GATEWAY_URL=http://localhost:8080
AGENT_REGISTRY_ENDPOINT=https://agentregistry.googleapis.com

# Memory & State Backends (Local or Managed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional Cloud Storage Bucket for Agent Artifacts
GCS_BUCKET_NAME=your-agent-artifacts-bucket

# Observability & Tracing
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_LOGGING=false
LOG_LEVEL=INFO
